# Root environment file read by docker-compose.yml.
# Copy to .env and replace the placeholders. Never commit .env.

# Password for the farm_admin PostgreSQL user.
POSTGRES_PASSWORD=CHANGE_ME
# Host port for PostgreSQL (5432-5436 are often used by native installs on Windows).
POSTGRES_HOST_PORT=5440

# Secret used to sign JWTs. Generate one with:
#   py -3.11 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME

ENVIRONMENT=development

# AI Advisor: free API keys for open-weights models (optional).
#   Groq: https://console.groq.com/keys   Cerebras: https://cloud.cerebras.ai
GROQ_API_KEY=
CEREBRAS_API_KEY=
# Production: true until commercial licenses are obtained for restricted sources.
KNOWLEDGE_COMMERCIAL_ONLY=false
