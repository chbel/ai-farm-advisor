# Local (non-Docker) settings for the Identity Service. Copy to .env.
# Under Docker Compose these values come from docker-compose.yml instead.

ENVIRONMENT=development

# PostgreSQL running in Docker (host port from the root .env, default 5440).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5440
POSTGRES_USER=farm_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=identity_db

# Optional: a full SQLAlchemy URL overrides the POSTGRES_* values above.
# DATABASE_URL=postgresql+psycopg://farm_admin:CHANGE_ME@127.0.0.1:5440/identity_db

# Must be identical to JWT_SECRET_KEY in the root .env.
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
