# Local (non-Docker) settings for the Farm Service. Copy to .env.
# Under Docker Compose these values come from docker-compose.yml instead.

ENVIRONMENT=development

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5440
POSTGRES_USER=farm_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=farm_db

# Must be identical to JWT_SECRET_KEY in the root .env / Identity Service.
JWT_SECRET_KEY=CHANGE_ME
