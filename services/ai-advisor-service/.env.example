# Local settings for the AI Advisor Service. Copy to .env.
# Under Docker Compose these values come from docker-compose.yml / the root .env.
ENVIRONMENT=development

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5440
POSTGRES_USER=farm_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=advisor_db

# Must be identical to JWT_SECRET_KEY in the root .env / Identity Service.
JWT_SECRET_KEY=CHANGE_ME

# Free API keys for open-weights models (Qwen3, Apache-2.0). Groq is tried first,
# Cerebras is the fallback. Without keys the advisor still answers with cited
# passages and farm data, but without AI-written text.
#   Groq:     https://console.groq.com/keys
#   Cerebras: https://cloud.cerebras.ai
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3-32b

# Production: true until commercial licenses are obtained for the other sources.
KNOWLEDGE_COMMERCIAL_ONLY=false
