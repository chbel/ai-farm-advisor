# Local settings for the Disease Detection Service. Copy to .env.
ENVIRONMENT=development

# Must be identical to JWT_SECRET_KEY in the root .env / Identity Service.
JWT_SECRET_KEY=CHANGE_ME

# Folder with one sub-folder per crop (e.g. models/tomato/model.onnx + metadata.json).
MODEL_DIR=models

# Predictions below this calibrated probability, or with a smaller margin over the
# second class, are reported as "uncertain".
MIN_CONFIDENCE=0.60
MIN_MARGIN=0.15
