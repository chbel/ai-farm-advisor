# Local (non-Docker) settings for the Weather Service. Copy to .env.
ENVIRONMENT=development

# Must be identical to JWT_SECRET_KEY in the root .env / Identity Service.
JWT_SECRET_KEY=CHANGE_ME

FARM_SERVICE_URL=http://127.0.0.1:8002

# Open-Meteo. The free endpoints below are for NON-COMMERCIAL use only.
# For commercial use, switch to the customer endpoints and set an API key:
#   OPEN_METEO_FORECAST_URL=https://customer-api.open-meteo.com/v1/forecast
#   OPEN_METEO_ARCHIVE_URL=https://customer-archive-api.open-meteo.com/v1/archive
#   OPEN_METEO_API_KEY=...
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
