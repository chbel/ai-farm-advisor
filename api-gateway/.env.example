APP_NAME=AI Farm Advisor API Gateway
APP_VERSION=1.0.0
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

# Internal microservice URLs (local uvicorn defaults).
IDENTITY_SERVICE_URL=http://127.0.0.1:8001
FARM_SERVICE_URL=http://127.0.0.1:8002
WEATHER_SERVICE_URL=http://127.0.0.1:8003
IRRIGATION_SERVICE_URL=http://127.0.0.1:8004
UPSTREAM_TIMEOUT_SECONDS=15

# Verifies access tokens. Must be identical to the Identity Service JWT_SECRET_KEY.
JWT_SECRET_KEY=CHANGE_ME
